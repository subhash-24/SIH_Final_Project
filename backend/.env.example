# Arogya-Saathi Backend Environment Variables — Template
# Speak Naturally. Get Structured. Care Smarter.

# Application
APP_NAME="Arogya-Saathi"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for development)
DATABASE_URL=sqlite:///./arogya_saathi.db

# Security
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=20

# CORS - frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# AI Services
ASR_SERVICE=mock
OCR_SERVICE=mock
NLP_SERVICE=cloud_llm

# Cloud LLM API Configuration
# Supported providers: "openai", "gemini", "mock"
# When LLM_API_KEY is omitted, the backend runs in deterministic rule-based fallback mode.
LLM_PROVIDER=openai
LLM_API_KEY=your_cloud_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ABHA (mock for development)
ABHA_SERVICE=mock
ABHA_SANDBOX_URL=https://sandbox.abdm.gov.in/api/v1

# Logging
LOG_LEVEL=INFO
